{
  "name": "novelforge-frontend",
  "version": "0.9.6",
  "description": "NovelForge Web Frontend",
  "author": "NovelForge Team",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "vue-tsc --NoEmit -p tsconfig.json",
