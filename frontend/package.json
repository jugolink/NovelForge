    "@vitejs/plugin-vue": "^5.2.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^10.0.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.97.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
